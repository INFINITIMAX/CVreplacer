# CVreplacer — variabile de mediu
#
# Copiaza in `.env` si completeaza. `.env` este ignorat de git.
# Nu pune niciodata o valoare reala in acest fisier.

# --- Claude API ---
# NU e obligatoriu daca esti autentificat prin `ant auth login` — SDK-ul
# citeste automat profilul de sub ~/.config/anthropic/.
# Verifica ce credentiale sunt active cu: ant auth status
# ANTHROPIC_API_KEY=

# Modelul folosit pentru extragerea cerintelor si evaluarea acoperirii.
CVR_MODEL=claude-opus-5

# Foloseste Batch API pentru rularea zilnica (reducere 50%, latenta mai mare).
# Pune 0 doar cand depanezi si vrei raspuns imediat.
CVR_USE_BATCH=1

# --- Surse ---
CVR_PEVIITOR_BASE=https://api.peviitor.ro/v1
# User-Agent trimis catre surse. Pune un contact real: e politicos si te scoate
# din categoria "bot anonim" daca cineva se uita in loguri.
CVR_USER_AGENT=CVreplacer/0.1 (proiect personal; contact: ...)
# Pauza minima intre cereri catre acelasi domeniu, in secunde.
CVR_RATE_LIMIT_SECONDS=1.0

# --- Filtre proprii, inainte de orice apel platit catre model ---
# Pragurile de ani, PE DOMENIU. Vezi spec.md R9b: profilul e o schimbare de
# cariera, nu un debut, deci un prag global ar taia gresit.
# Cerintele generice ("3+ ani experienta") se compara cu totalul.
CVR_YEARS_TOTAL=6.2
# Cerintele explicit software/AI ("3 ani in Python") se compara cu acesta.
CVR_YEARS_AI_SOFTWARE=0.6
# Cerintele de inginerie/proiectare.
CVR_YEARS_ENGINEERING=5.4
# Cate anunturi trimit cel mult catre model intr-o rulare (plasa de siguranta
# impotriva unei facturi neasteptate).
CVR_MAX_SCORED_PER_RUN=300

# --- Aplicatia locala ---
CVR_HOST=127.0.0.1
CVR_PORT=8000
CVR_DB_PATH=data/cvreplacer.db
